NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Segredo do Vercel Blob privado no servidor web e em scripts/migrate-uploads.mjs.
# As imagens continuam nas rotas do próprio EventMap.
BLOB_READ_WRITE_TOKEN=""

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=""
# Opcional na Vercel: segredo exclusivo da produção para separar o Neon das previews.
EVENTMAP_PRODUCTION_DATABASE_URL=""
# Use a direct PostgreSQL connection for LISTEN/NOTIFY if DATABASE_URL uses
# transaction pooling. Otherwise DATABASE_URL is reused.
DATABASE_LISTEN_URL=""
# Run the socket-enabled web server (`dev:socket` or `start:socket`) for realtime.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXTAUTH_SECRET=""

# Em produção, use a URL HTTPS do site em NEXTAUTH_URL e NEXT_PUBLIC_BASE_URL.
NEXTAUTH_URL="http://localhost:3000"
# URL canônica também usada por links de e-mail, calendário, metadados e validação de origem.
# Para um túnel HTTPS, use npm run dev:socket:public -- --url https://seu-link.trycloudflare.com
# Trocar o link exige reiniciar o servidor com a nova URL. Não use curingas na lista de origens.

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
SOCKET_IO_ALLOWED_ORIGINS="http://localhost:3000"
# Configure a origem HTTPS do Render no build da Vercel para conectar ao Socket.IO remoto.
NEXT_PUBLIC_SOCKET_URL=""
# Gere um segredo exclusivo e configure o mesmo valor na Vercel e no Render.
SOCKET_TICKET_SECRET=""
# Ative apenas no serviço dedicado do Render. Health check: /healthz.
SOCKET_ONLY=false

HOSTNAME="localhost"
PORT=3000

# Gmail com verificação em duas etapas. Use a senha de app e veja docs/deploy-email.md.
EMAIL_USER=""
EMAIL_PASS=""

# Recuperação de senha e confirmação usam o SMTP configurado por EMAIL_USER/PASS.
# Só ative se um proxy confiável sobrescrever os cabeçalhos de IP recebidos.
TRUST_PROXY_IP=false

# Opcional: npm run push:configure -- mailto:seu-email@seu-dominio.com
# Chave pública fornecida pelo endpoint de inscrição da Vercel.
WEB_PUSH_PUBLIC_KEY=""
# Chave privada e contato VAPID usados no worker de notificações do Render.
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""

# Segredo de assinatura do QR de check-in. Configure o mesmo valor na Vercel e na API mobile.
# Se vazio, a versão web usa NEXTAUTH_SECRET como fallback.
CHECKIN_SIGNING_SECRET=
