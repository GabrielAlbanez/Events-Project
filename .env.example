NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=""
GITHUB_ID=""
GITHUB_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXTAUTH_SECRET=""

NEXTAUTH_URL="http://localhost:3000"
# URL canônica também usada por links de e-mail, calendário, metadados e validação de origem.
# Para um túnel HTTPS, use npm run dev:socket:public -- --url https://seu-link.trycloudflare.com
# Trocar o link exige reiniciar o servidor com a nova URL. Não use curingas na lista de origens.

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
SOCKET_IO_ALLOWED_ORIGINS="http://localhost:3000"

HOSTNAME = "localhost"
PORT=3000

EMAIL_USER=""
EMAIL_PASS=""

# Recuperação de senha e confirmação usam o SMTP configurado por EMAIL_USER/PASS.
# Só ative se um proxy confiável sobrescrever os cabeçalhos de IP recebidos.
TRUST_PROXY_IP=false

# Opcional: npm run push:configure -- mailto:seu-email@seu-dominio.com
# A chave privada deve permanecer apenas no .env ignorado pelo Git.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""
