EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:4100
EXPO_PUBLIC_WEB_URL=http://SEU_IP_LOCAL:3000
EXPO_PUBLIC_SOCKET_URL=http://SEU_IP_LOCAL:4100
# IDs públicos OAuth, nunca client secrets. O Web client precisa corresponder à
# audiência incluída em GOOGLE_NATIVE_CLIENT_IDS no ambiente privado da API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Apenas configuração da compilação nativa (não EXPO_PUBLIC)
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
