{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile: Android (emulador)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/android-dev.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Mobile: API independente",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "api:dev"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Mobile: Metro (Android)",
      "type": "shell",
      "command": "npx.cmd",
      "args": [
        "expo",
        "start",
        "--port",
        "8082",
        "--localhost"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      },
      "options": {
        "env": {
          "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4100",
          "EXPO_PUBLIC_SOCKET_URL": "http://10.0.2.2:4100",
          "NODE_OPTIONS": "--dns-result-order=ipv4first"
        }
      }
    },
    {
      "label": "Mobile: TypeScript",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "typecheck"
      ],
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "Mobile: Lint",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "lint"
      ],
      "problemMatcher": []
    },
    {
      "label": "Mobile: Testes",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "test:client"
      ],
      "problemMatcher": []
    },
    {
      "label": "Ambiente: Expo Go",
      "type": "shell",
      "command": "npx.cmd",
      "args": [
        "expo",
        "start",
        "--go",
        "--lan"
      ],
      "options": {
        "cwd": "C:/Users/gabri/EventsApp/events-project-mobile",
        "env": {}
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Ambiente: Iniciar tudo",
      "dependsOn": [
        "Ambiente: Backend completo",
        "Ambiente: Expo desenvolvimento"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Ambiente: Backend completo",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "backend"
      ],
      "options": {
        "cwd": "C:/Users/gabri/EventsApp/events-project-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ambiente: Expo desenvolvimento",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "start:dev"
      ],
      "options": {
        "cwd": "C:/Users/gabri/EventsApp/events-project-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
