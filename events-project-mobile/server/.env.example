# Independent mobile API only. Never prefix secrets with EXPO_PUBLIC_.
DATABASE_URL=postgresql://...
# Optional dedicated non-transaction-pooled connection for cross-app realtime.
MOBILE_DATABASE_LISTEN_URL=
MOBILE_AUTH_SECRET=generate-a-private-random-secret-of-at-least-32-bytes
# Include the Web OAuth client ID returned by GoogleSignin as an ID-token audience.
GOOGLE_NATIVE_CLIENT_IDS=
MOBILE_API_HOST=0.0.0.0
MOBILE_API_PORT=4100
MOBILE_API_PUBLIC_URL=https://api.example.com
MOBILE_WEB_MEDIA_ORIGIN=https://www.example.com
MOBILE_API_BROWSER_ORIGINS=http://localhost:8081,http://localhost:3000
MOBILE_APP_URL=eventmap:///
EMAIL_USER=
EMAIL_PASS=

# Private shared key used only for QR check-in. Set the same value in Web and mobile API.
# Leave empty to preserve the previous local signing key until both processes are configured.
CHECKIN_SIGNING_SECRET=
